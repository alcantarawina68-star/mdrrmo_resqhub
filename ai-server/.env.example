PORT=8001

# Hugging Face inference API credentials
HF_API_URL=https://router.huggingface.co/hf-inference/models/dima806/ai_vs_human_generated_image_detection
HF_TOKEN=

# Optional shared secret. When set, Laravel's AI_DETECTION_TOKEN must match it.
REQUIRED_TOKEN=

# Upstream timeout in milliseconds (must stay below Laravel's AI_DETECTION_TIMEOUT)
HF_TIMEOUT_MS=60000